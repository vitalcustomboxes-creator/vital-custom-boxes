{
  "name": "hm-custom-packaging",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Next.js 15 rebuild of hmcustompackaging.com (Codewingz)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "assets:audit": "node scripts/audit-assets.mjs",
    "assets:optimize": "node scripts/optimize-product-images.mjs",
    "assets:convert-png": "node scripts/convert-public-pngs.mjs",
    "catalog:import": "node --env-file=.env.local scripts/import-products-to-firebase-r2.mjs",
    "catalog:publish": "node --env-file=.env.local scripts/publish-catalog.mjs",
    "catalog:rebuild-images": "node --env-file=.env.local scripts/rebuild-images-from-r2.mjs",
    "theme:restore": "node scripts/restore-logo-theme.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@vercel/postgres": "^0.10.0",
    "country-data-list": "^1.6.3",
    "firebase": "^12.16.0",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.18.0",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-circle-flags": "^0.0.30",
    "react-dom": "^19.2.7",
    "react-phone-number-input": "^3.4.17",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
